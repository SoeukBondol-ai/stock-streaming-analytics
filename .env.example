# ─────────────────────────────────────────────
# Stock Streaming Analytics – Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=stockpass
POSTGRES_DB=stockdb

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Stock API Keys (use at least one; mock generator runs if all are empty)
ALPHA_VANTAGE_API_KEY=get-some-api-key
FINNHUB_API_KEY=get-some-api-key
TWELVE_DATA_API_KEY=get-some-api-key

# Producer settings
STOCK_SYMBOLS=AAPL,MSFT,TSLA,GOOGL,AMZN
FETCH_INTERVAL_SECONDS=5

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_me_in_production
